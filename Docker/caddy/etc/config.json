{
  "logging": { "logs": { "default": { "level": "DEBUG" } } },
  "apps": {
    "layer4": {
      "servers": {
        "tls_proxy": {
          "listen": [":443"],
          "routes": [
            {
              "match": [{ "tls": { "sni": [] } }],
              "handle": [
                { "handler": "tls" },
                {
                  "handler": "proxy",
                  "upstreams": [{ "dial": ["sing-box:9443"] }]
                }
              ]
            }
          ]
        }
      }
    },
    "http": {
      "servers": {
        "web": {
          "listen": [":80"],
          "routes": [
            {
              "handle": [
                {
                  "handler": "static_response",
                  "headers": {
                    "Location": [
                      "https://{http.request.host}{http.request.uri}"
                    ]
                  },
                  "status_code": 301
                }
              ]
            }
          ]
        },
        "web-secure": {
          "listen": [":443"],
          "routes": [
            {
              "match": [{ "host": [] }],
              "handle": [{ "handler": "file_server", "root": "/var/www/html" }]
            }
          ],
          "tls_connection_policies": [
            {
              "match": { "sni": [] },
              "protocol_min": "tls1.2"
            }
          ]
        },
        "fallback": {
          "listen": [":9443"],
          "routes": [
            {
              "match": [{ "host": [] }],
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "match": [
                        {
                          "header": {
                            "Connection": ["*Upgrade*"],
                            "Upgrade": ["websocket"]
                          },
                          "path": []
                        }
                      ],
                      "handle": [
                        {
                          "flush_interval": -1,
                          "handler": "reverse_proxy",
                          "upstreams": [{ "dial": "sing-box:9443" }]
                        }
                      ]
                    },
                    {
                      "match": [{ "path": [], "protocol": "grpc" }],
                      "handle": [
                        {
                          "flush_interval": -1,
                          "handler": "reverse_proxy",
                          "transport": {
                            "protocol": "http",
                            "versions": ["h2c", "2"]
                          },
                          "upstreams": [{ "dial": "sing-box:9444" }]
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "body": "Bad Request",
                          "close": true,
                          "handler": "static_response",
                          "status_code": 400
                        }
                      ],
                      "terminal": true
                    }
                  ]
                }
              ]
            }
          ],
          "protocols": ["h1", "h2c"]
        }
      }
    },
    "tls": {
      "certificates": {
        "load_files": [
          {
            "certificate": "",
            "key": ""
          }
        ]
      }
    }
  }
}
